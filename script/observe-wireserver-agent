#! /usr/bin/env bash

set -euo pipefail

source script/env "$@"

if [[ $# -ne 2 ]]; then
  die "usage: script/observe-wireserver-agent <host-observation-json> <output-json>"
fi
if [[ "$PLATFORM" != "linux" || "$ARCH" != "x86_64" ]]; then
  die "WireServer agent observation requires Linux x86_64"
fi
if [[ "${CI:-}" != "true" || "${GITHUB_ACTIONS:-}" != "true" ]]; then
  die "WireServer agent observation runs only on disposable GitHub Actions runners"
fi

require_cmd python3
require_cmd sudo

sudo --non-interactive /usr/bin/python3 -E - "$1" "$2" <<'PY'
import json
import os
import pathlib
import re
import selectors
import stat
import subprocess
import sys
import time

AZURE_PLATFORM_ADDRESS = "168.63.129.16"
AZURE_PLATFORM_PORTS = {80, 32526}
MAX_CGROUP_PROCESSES = 16
MAX_OBSERVATIONS = 16
MAX_TRACE_BYTES = 1024 * 1024
MAX_TRACE_BUFFER_BYTES = 16 * 1024
OBSERVATION_SECONDS = 15
STRACE_PATH = "/usr/bin/strace"


def fail(message):
    raise SystemExit(message)


host_path = pathlib.Path(sys.argv[1])
output_path = pathlib.Path(sys.argv[2])
host = json.loads(host_path.read_text(encoding="utf-8"))
agent = host.get("systemd", {}).get("azure_platform_agent", {})
if host.get("schema_version") != 4:
    fail("WireServer agent observation did not receive the reviewed host evidence")
if output_path.exists():
    fail("WireServer agent observation requires an absent output path")


def write_document(control_group, observations):
    document = {
        "schema_version": 1,
        "status": "wireserver_agent_observation_only",
        "control_group": control_group,
        "destination": AZURE_PLATFORM_ADDRESS,
        "observations": observations,
        "observations_truncated": False,
    }
    encoded = json.dumps(document, sort_keys=True, separators=(",", ":"))
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        descriptor = os.open(output_path, flags, stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)
    except OSError:
        fail("WireServer agent observation could not create its bounded evidence file")
    with os.fdopen(descriptor, "w", encoding="utf-8") as destination:
        destination.write(encoded)
    print(encoded)


if agent.get("status") != "observed":
    write_document(None, [])
    raise SystemExit(0)
control_group = agent.get("control_group", "")
unit_name = agent.get("name", "")
if (
    not isinstance(control_group, str)
    or not isinstance(unit_name, str)
    or re.fullmatch(r"/[A-Za-z0-9_.@:/-]{1,255}", control_group) is None
    or not control_group.endswith("/" + unit_name)
):
    fail("WireServer agent observation received an invalid control group")
if not os.access(STRACE_PATH, os.X_OK):
    write_document(control_group, [])
    raise SystemExit(0)
cgroup_processes = pathlib.Path("/sys/fs/cgroup") / control_group.removeprefix("/") / "cgroup.procs"


def process_identity(pid):
    root = pathlib.Path(f"/proc/{pid}")
    try:
        metadata = root.stat()
        executable = (root / "exe").resolve(strict=True)
        executable_metadata = executable.stat()
        fields = (root / "stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()
        start_time = int(fields[19])
    except (FileNotFoundError, IndexError, OSError, UnicodeDecodeError, ValueError):
        return None
    basename = executable.name
    if metadata.st_uid != 0 or not re.fullmatch(r"[A-Za-z0-9._+-]{1,128}", basename):
        return None
    return {
        "pid": pid,
        "start_time_ticks": start_time,
        "executable_basename": basename,
        "executable_device": executable_metadata.st_dev,
        "executable_inode": executable_metadata.st_ino,
    }


def control_group_process_ids():
    try:
        process_ids = sorted({
            int(value)
            for value in cgroup_processes.read_text(encoding="utf-8").splitlines()
            if value.isdecimal()
        })
    except (FileNotFoundError, OSError, UnicodeDecodeError):
        return []
    if not process_ids or len(process_ids) > MAX_CGROUP_PROCESSES:
        return []
    return process_ids


process_ids = control_group_process_ids()
if not process_ids:
    write_document(control_group, [])
    raise SystemExit(0)
processes = {pid: process_identity(pid) for pid in process_ids}
if any(identity is None for identity in processes.values()):
    write_document(control_group, [])
    raise SystemExit(0)

command = [
    STRACE_PATH,
    "-qq",
    "-e",
    "trace=connect",
    "-e",
    "signal=none",
    "-s",
    "32",
]
for pid in process_ids:
    command.extend(["-p", str(pid)])
trace = subprocess.Popen(
    command,
    env={"LC_ALL": "C"},
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.PIPE,
    close_fds=True,
)
if trace.stderr is None:
    fail("WireServer agent observation could not capture the bounded trace")
os.set_blocking(trace.stderr.fileno(), False)
selector = selectors.DefaultSelector()
selector.register(trace.stderr, selectors.EVENT_READ)
connect_pattern = re.compile(
    rb'^(?:\[pid\s+([0-9]+)\]\s+)?connect\([^,]+,\s+'
    rb'\{sa_family=AF_INET,\s+sin_port=htons\((80|32526)\),\s+'
    rb'sin_addr=inet_addr\("168\.63\.129\.16"\)'
)


observations = {}
buffer = b""
bytes_seen = 0
deadline = time.monotonic() + OBSERVATION_SECONDS
try:
    while time.monotonic() < deadline:
        if trace.poll() is not None:
            break
        for key, _ in selector.select(timeout=0.1):
            chunk = os.read(key.fileobj.fileno(), 4096)
            if not chunk:
                continue
            bytes_seen += len(chunk)
            if bytes_seen > MAX_TRACE_BYTES:
                fail("WireServer agent observation exceeded its trace bound")
            buffer += chunk
            if len(buffer) > MAX_TRACE_BUFFER_BYTES:
                fail("WireServer agent observation exceeded its line bound")
            lines = buffer.split(b"\n")
            buffer = lines.pop()
            for line in lines:
                match = connect_pattern.search(line)
                if match is None:
                    continue
                if match.group(1) is None:
                    if len(process_ids) != 1:
                        continue
                    pid = process_ids[0]
                else:
                    pid = int(match.group(1))
                if pid not in control_group_process_ids():
                    continue
                identity = process_identity(pid)
                if identity is None:
                    continue
                port = int(match.group(2))
                key = (identity["pid"], identity["start_time_ticks"], port)
                observations[key] = {**identity, "port": port}
                if len(observations) > MAX_OBSERVATIONS:
                    fail("WireServer agent observation exceeded its result bound")
finally:
    selector.close()
    if trace.poll() is None:
        trace.terminate()
        try:
            trace.wait(timeout=2)
        except subprocess.TimeoutExpired:
            trace.kill()
            trace.wait(timeout=2)

write_document(control_group, [observations[key] for key in sorted(observations)])
PY
